# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/podcast_db

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# File Storage
AUDIO_STORAGE_PATH=./audio_files
MAX_UPLOAD_SIZE=500  # Maximum file size in MB

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Preset Tags (comma-separated)
PRESET_TAGS=technology,business,health,education,entertainment,science,sports,politics,culture,interviews,news,comedy,true-crime,history,self-improvement
